# Dockerfile-flink
FROM flink:1.17.1-scala_2.12-java11

# 1) Python + pip 설치
RUN apt-get update && \
    apt-get install -y python3 python3-pip && \
    ln -s /usr/bin/python3 /usr/bin/python

# 2) PyFlink 설치
RUN pip install apache-flink==1.17.1

# 3) Kafka Connector & Client JAR 추가 (✅ 여기 둘 다!)
ADD https://repo1.maven.org/maven2/org/apache/flink/flink-connector-kafka/1.17.1/flink-connector-kafka-1.17.1.jar /opt/flink/lib/
ADD https://repo1.maven.org/maven2/org/apache/kafka/kafka-clients/3.5.1/kafka-clients-3.5.1.jar /opt/flink/lib/

# 4) usrlib 폴더 준비
RUN mkdir -p /opt/flink/usrlib

WORKDIR /opt/flink